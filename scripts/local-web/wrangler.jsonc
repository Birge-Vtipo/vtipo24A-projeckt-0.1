{
  "name": "birge-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "dev": {"ip": "127.0.0.1", "port": 8840, "local_protocol": "http"},
  "vars": {"PUBLIC_ORIGIN": "http://127.0.0.1:8840", "BIRGE_LOCAL_WEB": "1"},
  "assets": {"directory": "../../dist/web-local", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none"},
  "durable_objects": {"bindings": [{"name": "BIRGE_CORE", "class_name": "LocalBirgeCore"}]},
  "migrations": [{"tag": "local-v1", "new_sqlite_classes": ["LocalBirgeCore"]}]
}
